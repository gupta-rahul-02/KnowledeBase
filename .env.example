# Copy to .env (never commit) and fill in real values before running.

# --- required: LLM ---
GROQ_API_KEY=your_groq_api_key_here

# --- required: Postgres (Neon) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- required: Qdrant (Qdrant Cloud) ---
QDRANT_URL=https://xxxxxxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key

# --- required: object storage (Cloudflare R2) ---
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=kb-uploads

# --- production only ---
# Comma-separated list of allowed CORS origins. For deployed usage set this to
# your public app URL (e.g. https://knowledebase-rag-<hash>-uc.a.run.app). For
# local dev keep the localhost defaults.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Enables /api/admin/* endpoints. Leave unset to disable admin API.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=

# --- optional (defaults shown) ---
SESSION_TTL_SECONDS=86400
SESSION_CLEANUP_INTERVAL_SECONDS=3600
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

# Postgres connection pool sizing (optional)
DB_POOL_MIN=1
DB_POOL_MAX=10
