# Copy to .env (never commit) and fill in real values before running.

# --- required ---
GROQ_API_KEY=your_groq_api_key_here

# --- production only ---
# Comma-separated list of allowed CORS origins. For Pattern A single-image
# deploys, this is your Fly.io URL. For local dev, keep the localhost defaults.
ALLOWED_ORIGINS=https://knowledebase-rag.fly.dev

# Enables the /api/admin/* endpoints. Leave unset to disable admin API.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=

# --- optional (defaults shown) ---
SESSION_TTL_SECONDS=86400
SESSION_CLEANUP_INTERVAL_SECONDS=3600
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

# Where the app stores DB + Chroma vectors + uploads.
# In containers, this MUST point to a mounted persistent volume.
DATA_DIR=.kb_data
